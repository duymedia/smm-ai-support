generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(255)
  username         String    @unique @db.VarChar(100)
  email            String    @unique @db.VarChar(255)
  password         String?   @db.VarChar(255)
  role             String    @default("customer") @db.VarChar(20)
  balance          Decimal   @default(0.0000) @db.Decimal(15, 4)
  avatar           String?   @db.VarChar(500)
  phone            String?   @unique @db.VarChar(50)
  telegramContact  String?   @map("telegram_contact") @db.VarChar(100)
  timezone         String    @default("Asia/Ho_Chi_Minh (GMT+7)") @db.VarChar(100)
  language         String    @default("en") @db.VarChar(10)
  currency         String    @default("USD") @db.VarChar(10)
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret") @db.VarChar(100)
  apiKey           String?   @unique @map("api_key") @db.VarChar(128)
  emailVerified    Boolean   @default(false) @map("email_verified")
  status           String    @default("active") @db.VarChar(20)
  lastLoginAt      DateTime? @map("last_login_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  loginSessions     LoginSession[]

  @@map("users")
}

model LoginSession {
  id           String    @id @default(cuid()) @db.VarChar(191)
  userId       Int       @map("user_id")
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  ipAddress    String?   @map("ip_address") @db.VarChar(100)
  location     String?   @db.VarChar(255)
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("login_sessions")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email], map: "idx_password_resets_email")
  @@index([expiresAt], map: "idx_password_resets_expires")
  @@map("password_resets")
}

model Setting {
  id                       Int      @id @default(autoincrement())
  defaultLanguage          String   @default("en") @map("default_language") @db.VarChar(10)
  defaultCurrency          String   @default("USD") @map("default_currency") @db.VarChar(10)
  siteName                 String   @default("NexusSMM Enterprise") @map("site_name")
  siteTagline              String?  @map("site_tagline")
  siteLogoUrl              String?  @map("site_logo_url")
  faviconUrl               String?  @map("favicon_url")
  primaryBrandColor        String   @default("#2563eb") @map("primary_brand_color")
  supportEmail             String   @default("support@nexussmm.io") @map("support_email")
  supportTelegram          String?  @map("support_telegram")
  supportHotline           String?  @map("support_hotline")
  smtpHost                 String?  @map("smtp_host")
  smtpPort                 Int      @default(587) @map("smtp_port")
  smtpUsername             String?  @map("smtp_username")
  smtpPassword             String?  @map("smtp_password")
  smtpEncryption           String   @default("tls") @map("smtp_encryption")
  smtpFromEmail            String?  @map("smtp_from_email")
  smtpFromName             String?  @map("smtp_from_name")
  allowUserRegistration    Boolean  @default(true) @map("allow_user_registration")
  allowFreeTrialPanel      Boolean  @default(true) @map("allow_free_trial_panel")
  allowGuestServiceViewing Boolean  @default(true) @map("allow_guest_service_viewing")
  enableLiveChatWidget     Boolean  @default(true) @map("enable_live_chat_widget")
  headerAnnouncementBar    String?  @map("header_announcement_bar") @db.Text
  headerAnnouncementActive Boolean  @default(true) @map("header_announcement_active")
  footerCopyright          String?  @map("footer_copyright")
  seoMetaTitle             String?  @map("seo_meta_title")
  seoMetaKeywords          String?  @map("seo_meta_keywords") @db.Text
  seoMetaDescription       String?  @map("seo_meta_description") @db.Text
  customCss                String?  @map("custom_css") @db.Text
  customHeaderScripts      String?  @map("custom_header_scripts") @db.Text
  maintenanceMode          Boolean  @default(false) @map("maintenance_mode")
  autoDispatchEnabled      Boolean  @default(true) @map("auto_dispatch_enabled")
  autoProvisioningEnabled  Boolean  @default(true) @map("auto_provisioning_enabled")
  autoBankingSync          Boolean  @default(true) @map("auto_banking_sync")
  usdToVndRate             Decimal  @default(25400.00) @map("usd_to_vnd_rate") @db.Decimal(12, 2)
  minDepositUsd            Decimal  @default(5.00) @map("min_deposit_usd") @db.Decimal(10, 2)
  vietqrBankCode           String?  @default("MBBANK") @map("vietqr_bank_code")
  vietqrAccountNumber      String?  @default("0988889999") @map("vietqr_account_number")
  vietqrAccountHolder      String?  @default("NEXUS SMM HOLDINGS") @map("vietqr_account_holder")
  vietqrAutoVerify         Boolean  @default(true) @map("vietqr_auto_verify")
  usdtTrc20Address         String?  @map("usdt_trc20_address")
  usdtErc20Address         String?  @map("usdt_erc20_address")
  cryptoAutoConfirmBlocks  Int      @default(3) @map("crypto_auto_confirm_blocks")
  syncInterval             Int      @default(3) @map("sync_interval")
  autoRefundOnError        Boolean  @default(true) @map("auto_refund_on_error")
  lowBalanceAlertThreshold Decimal  @default(50.00) @map("low_balance_alert_threshold") @db.Decimal(10, 2)
  defaultProfitMargin      Decimal  @default(25.00) @map("default_profit_margin") @db.Decimal(5, 2)
  autoRetryStalledOrders   Boolean  @default(true) @map("auto_retry_stalled_orders")
  filterSensitiveKeywords  Boolean  @default(true) @map("filter_sensitive_keywords")
  webhookUrl               String?  @map("webhook_url")
  webhookSecret            String?  @map("webhook_secret")
  geminiModel              String   @default("gemini-2.5-flash") @map("gemini_model")
  systemPrompt             String?  @map("system_prompt") @db.Text
  autoTicketReplyEnabled   Boolean  @default(true) @map("auto_ticket_reply_enabled")
  autoDnsDiagnostic        Boolean  @default(true) @map("auto_dns_diagnostic")
  autoMarginOptimizer      Boolean  @default(true) @map("auto_margin_optimizer")
  maxDailyAiTokens         Int      @default(500000) @map("max_daily_ai_tokens")
  temperature              Decimal  @default(0.70) @map("temperature") @db.Decimal(3, 2)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
